# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public site URL used for metadata, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Events source - Google Sheet published as CSV
# ---------------------------------------------------------------------------
# Option A: the spreadsheet id taken from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=

# Optional: which tab to read. Use the gid from the URL, or the tab name.
GOOGLE_SHEET_GID=
GOOGLE_SHEET_NAME=Events

# Option B: a full "Publish to web" CSV link. Overrides the options above.
GOOGLE_SHEET_CSV_URL=

# How long (in seconds) a generated page may serve before the sheet is refetched.
EVENTS_REVALIDATE_SECONDS=300

# Secret for POST /api/revalidate, used to publish sheet edits instantly.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Registrations - Google Apps Script Web App
# ---------------------------------------------------------------------------
# Endpoint that appends submitted registrations to a Google Sheet.
# Leave empty locally to run the form without persisting data.
GOOGLE_SHEETS_WEBAPP_URL=

# Shared secret validated inside the Apps Script before a row is written.
GOOGLE_SHEETS_SHARED_SECRET=
