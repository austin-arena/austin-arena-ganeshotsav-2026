# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public site URL used for metadata, canonical URLs and the sitemap.
# GitHub Pages example: https://austin-arena.github.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Events source - Google Sheet published as CSV
# ---------------------------------------------------------------------------
# Option A: the spreadsheet id taken from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=

# Optional: which tab to read. Use the gid from the URL, or the tab name.
GOOGLE_SHEET_GID=
GOOGLE_SHEET_NAME=Events

# Option B: a full "Publish to web" CSV link. Overrides the options above.
GOOGLE_SHEET_CSV_URL=

# How long (in seconds) a generated page may serve before the sheet is refetched.
# Server deployments only - a static export reads the sheet at build time.
EVENTS_REVALIDATE_SECONDS=300

# Secret for POST /api/revalidate, used to publish sheet edits instantly.
# Server deployments only.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# GitHub Pages (static export)
# ---------------------------------------------------------------------------
# Sub-path the site is served from. For a project site this is "/<repo-name>".
# Set to an empty string for a user site or a custom domain served from the root.
GITHUB_PAGES_BASE_PATH=/austin-arena-ganeshotsav-2026

# ---------------------------------------------------------------------------
# Registrations
# ---------------------------------------------------------------------------
# SERVER DEPLOYMENTS (Vercel): the form posts to /api/register, which forwards
# to the Apps Script endpoint below. These values stay private.
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# STATIC DEPLOYMENTS (GitHub Pages): there is no server, so the browser posts
# straight to the Apps Script Web App. Anything with a NEXT_PUBLIC_ prefix is
# visible in the page source - see the README before setting a secret here.
NEXT_PUBLIC_REGISTRATION_ENDPOINT=
NEXT_PUBLIC_REGISTRATION_SECRET=
