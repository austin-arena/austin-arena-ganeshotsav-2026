{
  "name": "austin-arena-ganeshotsav",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:build && next build",
    "build:static": "node scripts/build-static.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "preview:static": "node scripts/preview-static.mjs",
    "deploy": "npm run build:static && npm run verify:static && gh-pages -d out --dotfiles",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/csv-to-json.mjs",
    "data:validate": "node scripts/validate-events.mjs",
    "data:sync": "node scripts/sync-sheet.mjs",
    "check": "npm run data:validate && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "csv-parse": "^5.6.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.0"
  }
}
